# fleet.env.example — the site file for a four-node DGX Spark fleet. Copy it to launch/fleet.env (git-ignored) and
# replace every value: the values here are EXAMPLES, not defaults. Plain bash, sourced by every script in launch/;
# keep the arrays as arrays, in rank order, and quote nothing that does not need it. Rank 0 is the node you run the
# scripts from; ranks 1–3 are reached with key-based ssh as USERS[r]@NODES[r].
# MIT License, Copyright (c) 2026 Aiden Le.

# NODES: the fabric (RoCE) IPv4 address of each rank, rank 0 first. This is the address NCCL, the RDMA runtime and
# the launcher's ssh use. Find it with `ip -br addr` on each node: the address on the interface that carries the RoCE
# subnet (a 200G ConnectX-7 port), not the management network.
NODES=(192.0.2.11 192.0.2.12 192.0.2.13 192.0.2.14)

# USERS: the login user on each rank, in the same order. Rank 0's entry is the local user; the others must accept
# `ssh USERS[r]@NODES[r]` from rank 0 without a password (ssh-copy-id) and be in the docker group there.
USERS=(alice alice bob bob)

# HOMES: the home directory of that user on each rank (`echo $HOME` there). Relative ENGRAM_LOCAL_DIR, CACHE_DIR and
# LOG_DIR values below are resolved under it on that rank.
HOMES=(/home/alice /home/alice /home/bob /home/bob)

# FABRIC_IFACE: the network interface that carries the NODES address, the same name on every node. From
# `ip -br addr`: the interface listed next to the fabric IPv4. NCCL and gloo bind their control sockets to it.
FABRIC_IFACE=enp1s0f0np0

# RDMA_HCAS: the RDMA devices to use, comma-separated, the same names on every node. `ls /sys/class/infiniband` lists
# them; list every function that faces the fabric (two per node on a Spark with both ConnectX-7 ports cabled). The
# launcher probes the FIRST one for the RoCE-v2 GID index of the NODES address on each node and passes it to NCCL and
# the RDMA runtime; a wrong index fails every RDMA connect, which is why it is probed and never assumed.
RDMA_HCAS=rocep1s0f0,roceP2p1s0f0

# FABRIC_SUBNET: the fabric subnet in CIDR form (from `ip -br addr`: the fabric address with its prefix length,
# e.g. 192.0.2.1/24 -> 192.0.2.0/24). NCCL restricts its RDMA addresses to it (NCCL_IB_ADDR_RANGE).
FABRIC_SUBNET=192.0.2.0/24

# MODEL_REPO: where the HuggingFace repo directory of the checkpoint (models--deepseek-ai--DeepSeek-V4.1-Flash) is
# mounted on the ranks that do NOT hold it: an NFS export from the node that does. Mount the repo directory, not the
# snapshot inside it, so the snapshot's blob symlinks (../../blobs/...) resolve. Same path on every such rank.
MODEL_REPO=/mnt/dsv41

# SNAP: the snapshot directory inside the repo, i.e. the revision you downloaded: `ls <repo>/snapshots` shows it
# (one 40-hex-character directory). The model path inside the container is /models/repo/$SNAP.
SNAP=snapshots/0123456789abcdef0123456789abcdef01234567

# MODEL_HOST_RANK: the rank whose node holds the checkpoint on local disk. That rank reads its Engram rows straight
# from the shards (no node-local copy needed) and needs ENGRAM_ROWS_HOST below. Leave empty if every rank mounts the
# checkpoint over the network and has its own row copy.
MODEL_HOST_RANK=1

# MODEL_REPO_HOST: the repo directory's path on MODEL_HOST_RANK's node (usually the HuggingFace cache:
# ~/.cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4.1-Flash). Ignored when MODEL_HOST_RANK is empty.
MODEL_REPO_HOST=/home/alice/.cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4.1-Flash

# ENGRAM_ROWS_HOST: the Engram row ranges of MODEL_HOST_RANK, as LAYER:START:END pairs, comma-separated. Get them
# from `python3 tools/engram_partition.py <repo>/$SNAP`, which prints every rank's ranges (space-separated, for
# tools/engram_local.py) — join the pairs of the host rank with commas here. The example is rank 1 of the default
# four-way split. The four ranks' ranges must tile each table exactly; the engine refuses to start otherwise.
ENGRAM_ROWS_HOST=1:96001542:192003084,14:96004170:192008341

# ENGRAM_LOCAL_DIR: on every other rank, the directory holding that rank's node-local sparse row copy, written by
# `python3 tools/engram_local.py <repo>/$SNAP <this dir> <that rank's ranges>` on that node (about 50 GB of NVMe;
# its engram-local.json manifest carries the ranges). Relative to the rank's HOMES entry, or absolute.
ENGRAM_LOCAL_DIR=dsv41-engram-local

# CACHE_DIR: a writable per-node directory mounted as /root/.cache in the container, for JIT-compiled kernels
# (the first boot compiles, later boots reuse). Relative to the rank's home, or absolute.
CACHE_DIR=sgl-dsv41-cache

# LOG_DIR: where relaunch.sh, window-sgl.sh and the watchdog write their logs and the watchdog's postmortem
# captures, on rank 0. Relative to $HOME or absolute.
LOG_DIR=sgl-dsv41-logs

# SERVED_ALIASES: extra model ids to list on /v1/models besides the served name deepseek-v4.1-flash, comma-separated
# (for clients that ask for an older or a generic name). Empty by default: nothing extra is listed. The form below
# lets an exported SERVED_ALIASES in the environment win over this file.
SERVED_ALIASES="${SERVED_ALIASES:-}"

# Optional: shell commands that stop / relaunch another engine that may hold the production port on these nodes
# (relaunch.sh runs PREVIOUS_STACK_STOP before launching; window-sgl.sh with RESTORE=previous runs
# PREVIOUS_STACK_RELAUNCH afterwards). Leave both empty when this stack is the only one.
PREVIOUS_STACK_STOP=
PREVIOUS_STACK_RELAUNCH=

# Optional: IMAGE overrides the image production.sh, relaunch.sh and the watchdog use (e.g. a local build:
# IMAGE=sglang-dsv41-spark:local). Leave unset to run the published tag.
